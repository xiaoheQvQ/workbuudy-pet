{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "workbuddy-PET",
  "version": "1.0.4",
  "identifier": "io.github.xiaoheqvq.workbuddy-pet",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "macOSPrivateApi": true,
    "windows": [
      {
        "label": "main",
        "title": "WorkBuddy-PET 桌面宠物",
        "width": 1100,
        "height": 760,
        "minWidth": 800,
        "minHeight": 600,
        "center": true,
        "resizable": true,
        "visible": false,
        "focus": true
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": ["**"]
      }
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": ["nsis", "dmg", "app", "deb", "appimage"],
    "resources": {
      "resources/pets": "pets/"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "publisher": "xiaoheQvQ",
    "shortDescription": "WorkBuddy-PET 桌面宠物",
    "longDescription": "WorkBuddy-PET：独立的桌面宠物应用，可与 WorkBuddy 联动并支持内置宠物与 petdex.dev 在线市场浏览下载。",
    "category": "Entertainment",
    "macOS": {
      "minimumSystemVersion": "10.13",
      "signingIdentity": "-"
    },
    "windows": {
      "nsis": {
        "languages": ["SimpChinese", "English"],
        "displayLanguageSelector": true
      }
    },
    "linux": {
      "deb": {
        "depends": ["libwebkit2gtk-4.1-0"]
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEQ4RDhENERCMEYzRjQ0OTkKUldTWlJEOFAyOVRZMkZNQmJwaHE3VWhIM3llRmxrNG1lRDF4VmhZZlZORGx6Y2hQRnkxNENkK2oK",
      "endpoints": [
        "https://github.com/xiaoheQvQ/workbuudy-pet/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
